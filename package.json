{
  "name": "theteacher",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:app": "pnpm --filter @theteacher/app dev",
    "dev:api": "pnpm --filter @theteacher/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:format": "pnpm dlx prisma format --schema packages/shared/prisma/schema.prisma",
    "db:migrate": "pnpm dlx prisma migrate dev --schema packages/shared/prisma/schema.prisma",
    "db:deploy": "pnpm dlx prisma migrate deploy --schema packages/shared/prisma/schema.prisma",
    "db:generate": "pnpm dlx prisma generate --schema packages/shared/prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-solid": "^0.14.3",
    "prettier": "^3.3.3",
    "prisma": "^6.19.0",
    "typescript-eslint": "^8.11.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  }
}
