# TheTeacher environment template
# ------------------------------------------------------------------------------
# Copy the relevant blocks to:
# - app/.env.local (Vite/Tauri client)
# - services/api/.dev.vars for wrangler dev
# - Cloudflare Workers Secrets for production (`cd services/api && wrangler secret put <NAME>`)
# Do not commit real keys.

# --- App (SolidJS + Tauri) ----------------------------------------------------
# Public base URL for the Hono API worker (used by Vite/Tauri client).
VITE_API_BASE_URL=http://127.0.0.1:8787

# --- API / Workers (.dev.vars) -----------------------------------------------
# Primary LLM (chat/completions) configuration.
OPENAI_API_KEY=sk-...
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding + vector search.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vectorize binding is configured in `services/api/wrangler.toml` (binding name: `VECTORIZE`).
# Dimensions must match the embedding model (1536 for `text-embedding-3-small`).
VECTORIZE_INDEX_DIMENSIONS=1536

# Transcription / audio.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Vision / OCR (pick a provider and fill its keys).
OCR_PROVIDER=cloudflare_ai # cloudflare_ai|openai|gcp_vision|tesseract
# When using Cloudflare Workers AI Vision/OCR (recommend for cost control).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN= # must allow Workers AI + Vectorize/R2 writes if used
AI_GATEWAY_SLUG= # optional: Workers AI Gateway route name if configured
# When using OpenAI Vision.
OPENAI_VISION_MODEL=gpt-4o-mini
# When using Google Cloud Vision.
GCP_PROJECT_ID=
GCP_VISION_API_KEY=
GCP_VISION_LOCATION=global

# Storage (local dev uses the default Tauri material path; set R2 to mirror/upload).
MATERIAL_LOCAL_ROOT=.theteacher/materials
R2_BUCKET=theteacher-materials
R2_PUBLIC_HOST=https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Database / migrations
# D1 is bound via wrangler.toml (`DB` binding); no env var required. Keep
# DATABASE_URL here only if you add a non-D1 client for tooling.
DATABASE_URL=

# Observability / toggles
LOG_LEVEL=info
